# SmartNeb Mobile App Environment Configuration Template
# Copy this file to .env.development for local testing, or configure variables in eas.json for EAS builds.

# For Production Cloud Deployment (default):
# EXPO_PUBLIC_API_URL=https://api.smartneb.health/api/v1

# For Local LAN Development Testing:
# Replace <YOUR_LOCAL_IP> with your machine's Wi-Fi IPv4 address (e.g., run 'ipconfig'):
# EXPO_PUBLIC_DEV_API_URL=http://<YOUR_LOCAL_IP>:5000/api/v1

# For Android Emulator Testing:
# EXPO_PUBLIC_DEV_API_URL=http://10.0.2.2:5000/api/v1

# Firebase Realtime Database Configuration:
# EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://smartneb-d98e1-default-rtdb.asia-southeast1.firebasedatabase.app
# EXPO_PUBLIC_FIREBASE_DEFAULT_NODE=Patient1
