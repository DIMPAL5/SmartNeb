{
  "expo": {
    "name": "SmartNeb Health",
    "slug": "smartneb-health",
    "version": "2.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartneb.health",
      "infoPlist": {
        "NSCameraUsageDescription": "SmartNeb requires camera access to scan device QR codes and associate smart nebulizers.",
        "NSBluetoothAlwaysUsageDescription": "SmartNeb requires Bluetooth to discover and communicate with smart nebulizers.",
        "NSLocalNetworkUsageDescription": "SmartNeb requires local network access for development debugging and LAN sensor discovery."
      }
    },
    "android": {
      "package": "com.smartneb.health",
      "versionCode": 9,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "INTERNET",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "2bd91227-c802-42c0-9c74-8486c949583f"
      }
    },
    "owner": "smartneb"
  }
}
