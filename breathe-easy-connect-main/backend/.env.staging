# Staging Environment Template
NODE_ENV=staging
PORT=5000

# Managed Staging MySQL via TLS
DATABASE_URL="mysql://smartneb_stage:REPLACE_STAGE_PASSWORD@stage-mysql.internal:3306/smartneb_staging?sslaccept=strict&connection_limit=5&pool_timeout=15"

# Hosted Staging MQTT Broker (TLS on 8883)
MQTT_BROKER_URL="mqtts://stage-broker.smartneb.health:8883"
MQTT_USERNAME="stage_backend_service"
MQTT_PASSWORD="REPLACE_STAGE_MQTT_PASSWORD"

# Strong Staging JWT Secrets
JWT_SECRET="REPLACE_WITH_UNIQUE_STAGE_SECRET_KEY_MIN_64_CHARACTERS"
JWT_REFRESH_SECRET="REPLACE_WITH_UNIQUE_STAGE_REFRESH_KEY_MIN_64_CHARACTERS"

GEMINI_API_KEY="REPLACE_STAGE_GEMINI_KEY"
CORS_ORIGIN="https://staging.smartneb.health"
PUBLIC_API_URL="https://stage-api.smartneb.health/api/v1"
PUBLIC_WS_URL="wss://stage-api.smartneb.health"
