# ==============================================================================
# SMARTNEB BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.development, .env.staging, or .env.production as needed.
# NEVER commit production secret values to version control.
# ==============================================================================

# Core Application Runtime
NODE_ENV=development
PORT=5000

# Managed MySQL Database Connection (via TLS)
# Syntax: mysql://[user]:[password]@[host]:[port]/[database]?sslaccept=strict&connection_limit=10&pool_timeout=20
DATABASE_URL="mysql://smartneb_user:REPLACE_WITH_STRONG_PASSWORD@db-prod.internal.domain:3306/smartneb_prod?sslaccept=strict&connection_limit=10&pool_timeout=20"

# Hosted MQTT Broker (TLS on port 8883)
# Examples: EMQX Cloud (emqxsl://...), HiveMQ Cloud (tls://...), AWS IoT Core (mqtts://...)
MQTT_BROKER_URL="mqtts://broker.smartneb.health:8883"
MQTT_USERNAME="backend_service_client"
MQTT_PASSWORD="REPLACE_WITH_SECURE_MQTT_SECRET"

# JWT Token Cryptographic Secrets (Mandatory in Production >= 64 characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_ACCESS_SECRET_MIN_64_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_REFRESH_SECRET_MIN_64_CHARS"

# Google Gemini AI API Key (Server-side Only)
GEMINI_API_KEY="AIzaSy_REPLACE_WITH_VALID_GEMINI_API_KEY"

# CORS Allowed Origins (Comma-separated HTTPS domains)
CORS_ORIGIN="https://app.smartneb.health,https://admin.smartneb.health"

# Push Notifications (Firebase Admin SDK / Expo Push)
EXPO_ACCESS_TOKEN="REPLACE_WITH_EXPO_PUSH_TOKEN"
FIREBASE_SERVICE_ACCOUNT_PATH="/etc/smartneb/firebase-service-account.json"

# SMS / WhatsApp OTP Authentication (Twilio / MSG91)
TWILIO_ACCOUNT_SID="AC_REPLACE_WITH_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="REPLACE_WITH_TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER="+18005550199"
MSG91_AUTH_KEY="REPLACE_WITH_MSG91_AUTH_KEY"
MSG91_TEMPLATE_ID="REPLACE_WITH_MSG91_TEMPLATE_ID"

# Environmental & Air Quality API
OPENWEATHER_API_KEY="REPLACE_WITH_OPENWEATHER_OR_IQAIR_API_KEY"

# WebRTC & Telehealth Consultation Services
TELEHEALTH_RTC_PROVIDER="livekit"
LIVEKIT_API_KEY="REPLACE_WITH_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="REPLACE_WITH_LIVEKIT_API_SECRET"

# Public API & WebSocket Base URL
PUBLIC_API_URL="https://api.smartneb.health/api/v1"
PUBLIC_WS_URL="wss://api.smartneb.health"
