# Production Environment Template (Fill in via Hosted Secret Manager or Cloud Dashboard)
NODE_ENV=production
PORT=5000

# Managed Production MySQL (TLS Enforced, Pooled)
DATABASE_URL="mysql://smartneb_prod_user:REPLACE_WITH_HIGH_ENTROPY_PROD_PASSWORD@prod-mysql.cluster.region.provider.com:3306/smartneb_prod?sslaccept=strict&connection_limit=20&pool_timeout=20"

# Hosted Production MQTT Broker (TLS on 8883)
MQTT_BROKER_URL="mqtts://broker.smartneb.health:8883"
MQTT_USERNAME="prod_backend_service"
MQTT_PASSWORD="REPLACE_WITH_HIGH_ENTROPY_MQTT_SERVICE_PASSWORD"

# Cryptographically Secure Production JWT Secrets
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_PROD_JWT_SECRET_MIN_64_CHARACTERS"
JWT_REFRESH_SECRET="REPLACE_WITH_SECURE_RANDOM_PROD_JWT_REFRESH_SECRET_MIN_64_CHARACTERS"

GEMINI_API_KEY="REPLACE_WITH_PRODUCTION_GEMINI_API_KEY"
CORS_ORIGIN="https://app.smartneb.health,https://admin.smartneb.health"
PUBLIC_API_URL="https://api.smartneb.health/api/v1"
PUBLIC_WS_URL="wss://api.smartneb.health"
