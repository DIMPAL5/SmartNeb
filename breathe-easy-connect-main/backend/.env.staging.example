# ==============================================================================
# SMARTNEB STAGING ENVIRONMENT CONFIGURATION TEMPLATE (.env.staging.example)
# Copy to .env.staging on your staging environment.
# ==============================================================================

# Application Environment
NODE_ENV=staging
PORT=5000
HOST=0.0.0.0

# Domain & CORS Allow-list
ALLOWED_ORIGINS="https://staging-app.smartneb.health,https://staging-api.smartneb.health"
PUBLIC_API_URL="https://staging-api.smartneb.health/api/v1"
PUBLIC_WS_URL="wss://staging-api.smartneb.health"

# Staging MySQL Database Connection (via TLS)
DATABASE_URL="mysql://smartneb_staging_user:REPLACE_WITH_STAGING_DB_PASSWORD@staging-db.internal.domain:3306/smartneb_staging?sslaccept=strict&connection_limit=10&pool_timeout=20"

# Staging MQTT Broker (Port 8883)
MQTT_BROKER_HOST="staging-broker.smartneb.health"
MQTT_BROKER_URL="mqtts://staging-broker.smartneb.health:8883"
MQTT_TLS_PORT=8883
MQTT_USERNAME="backend_staging_client"
MQTT_PASSWORD="REPLACE_WITH_STAGING_MQTT_PASSWORD"

# Staging JWT Secrets
JWT_SECRET="REPLACE_WITH_STAGING_JWT_SECRET_KEY_MIN_64_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_STAGING_JWT_REFRESH_SECRET_KEY_MIN_64_CHARS"

# Integrations
EXPO_ACCESS_TOKEN="REPLACE_WITH_STAGING_EXPO_TOKEN"
MSG91_AUTH_KEY="REPLACE_WITH_MSG91_STAGING_KEY"
TWILIO_ACCOUNT_SID="REPLACE_WITH_TWILIO_STAGING_SID"
TWILIO_AUTH_TOKEN="REPLACE_WITH_TWILIO_STAGING_TOKEN"
TWILIO_PHONE_NUMBER="REPLACE_WITH_TWILIO_STAGING_PHONE"
GEMINI_API_KEY="AIzaSy_REPLACE_WITH_STAGING_GEMINI_KEY"
