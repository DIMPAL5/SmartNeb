# ==============================================================================
# SMARTNEB PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production.example)
# DO NOT EDIT OR COMMIT REAL SECRETS TO THIS FILE.
# Copy to .env.production on your hosting server and fill in real production values.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Domain & CORS Allow-list
ALLOWED_ORIGINS="https://app.smartneb.health,https://admin.smartneb.health"
PUBLIC_API_URL="https://api.smartneb.health/api/v1"
PUBLIC_WS_URL="wss://api.smartneb.health"

# Managed Cloud MySQL Database (AWS RDS / DigitalOcean Managed MySQL via TLS)
# Must include sslaccept=strict or sslmode=REQUIRED
DATABASE_URL="mysql://smartneb_prod_user:REPLACE_WITH_STRONG_DB_PASSWORD@smartneb-db.cluster-xxxx.rds.amazonaws.com:3306/smartneb_prod?sslaccept=strict&connection_limit=20&pool_timeout=30"

# Hosted Standalone MQTT Broker (TLS on Port 8883 / WSS on 8084)
MQTT_BROKER_HOST="broker.smartneb.health"
MQTT_BROKER_URL="mqtts://broker.smartneb.health:8883"
MQTT_TLS_PORT=8883
MQTT_USERNAME="backend_service_client"
MQTT_PASSWORD="REPLACE_WITH_SECURE_MQTT_BACKEND_PASSWORD"

# Cryptographic JWT Secrets (Minimum 64 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_JWT_SECRET_64_CHARS_MINIMUM"
JWT_REFRESH_SECRET="REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_JWT_REFRESH_SECRET_64_CHARS_MINIMUM"

# Push Notifications & SMS OTP Integration
EXPO_ACCESS_TOKEN="REPLACE_WITH_EXPO_PUSH_ACCESS_TOKEN"
MSG91_AUTH_KEY="REPLACE_WITH_MSG91_PRODUCTION_AUTH_KEY"
MSG91_TEMPLATE_ID="REPLACE_WITH_MSG91_OTP_TEMPLATE_ID"
TWILIO_ACCOUNT_SID="REPLACE_WITH_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="REPLACE_WITH_TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER="REPLACE_WITH_TWILIO_PHONE_NUMBER"

# Gemini AI API Key (Optional)
GEMINI_API_KEY="AIzaSy_REPLACE_WITH_REAL_GEMINI_API_KEY"
